#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT"

die() {
    echo "bootstrap: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

for command in git gh jq copier shellcheck actionlint; do
    require_command "$command"
done

[[ ! -e .git ]] || die "refusing to run: .git already exists"
[[ -f copier.yml ]] || die "copier.yml is missing"
[[ -f .github/labels.yml ]] || die ".github/labels.yml is missing"
[[ -f .github/ruleset.json ]] || die ".github/ruleset.json is missing; run copier first"

repo_name="${BOOTSTRAP_REPO_NAME:-$(basename "$ROOT")}"
owner="${BOOTSTRAP_GITHUB_OWNER:-${GITHUB_OWNER:-}}"
if [[ -z "$owner" ]]; then
    owner="$(gh api user --jq '.login')" || die "cannot determine GitHub owner"
fi

case "$owner" in
    *[!a-zA-Z0-9_.-]*|"") die "invalid GitHub owner: $owner" ;;
esac
case "$repo_name" in
    *[!a-zA-Z0-9_.-]*|"") die "invalid repository name: $repo_name" ;;
esac

target_repo="$owner/$repo_name"
capability_repo="${BOOTSTRAP_CAPABILITY_REPO:-piergiorgio1999/agent-template}"

if ! gh pr list --repo "$capability_repo" --state all --limit 1 --json closingIssuesReferences >/dev/null 2>&1; then
    die "installed gh does not support closingIssuesReferences; upgrade gh and retry"
fi

if gh api "repos/$target_repo" >/dev/null 2>&1; then
    die "refusing to run: GitHub repository $target_repo already exists"
fi

if gh api "users/$owner" >/dev/null 2>&1; then
    owner_type="user"
elif gh api "orgs/$owner" >/dev/null 2>&1; then
    owner_type="organization"
else
    die "cannot resolve GitHub owner $owner"
fi

git config user.name >/dev/null 2>&1 || die "git user.name is not configured"
git config user.email >/dev/null 2>&1 || die "git user.email is not configured"

visibility="${BOOTSTRAP_VISIBILITY:-private}"
case "$visibility" in
    private|public|internal) ;;
    *) die "BOOTSTRAP_VISIBILITY must be private, public, or internal" ;;
esac

echo "bootstrap: owner=$owner ($owner_type), repository=$target_repo"
echo "bootstrap: verifying repository creation and ruleset permissions"

git init >/dev/null
git symbolic-ref HEAD refs/heads/main
git add -A
git diff --cached --quiet && die "no files to commit"
git commit -m "chore: initialize generated repository" >/dev/null

gh repo create "$target_repo" "--$visibility" --source=. --remote=origin --push

gh api "repos/$target_repo" --method PATCH -F delete_branch_on_merge=true >/dev/null \
    || die "cannot enable delete_branch_on_merge for $target_repo"

permissions="$(gh api "repos/$target_repo" --jq '.permissions')"
if ! jq -e '.admin == true' >/dev/null <<<"$permissions"; then
    die "authenticated principal lacks repository admin permission required for Ruleset setup"
fi

gh api "repos/$target_repo/rulesets" --method POST --input .github/ruleset.json >/dev/null

echo "bootstrap: repository created, initial commit pushed, and ruleset applied"
echo "bootstrap: first CI and label-sync workflows are triggered by the main push"
echo "bootstrap: verify with gh run list --repo $target_repo --branch main"
