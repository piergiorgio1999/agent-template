{
  "version": 1,
  "matchPolicy": "first-match-wins",
  "scopes": [
    {
      "name": "github",
      "paths": [
        ".github/**"
      ]
    },
    {
      "name": "documentation",
      "paths": [
        "*.md",
        "docs/**"
      ]
    },
    {
      "name": "typescript",
      "paths": [
        "checks/typescript/**"
      ]
    },
    {
      "name": "swift",
      "paths": [
        "checks/swift/**"
      ]
    },
    {
      "name": "python",
      "paths": [
        "checks/python/**"
      ]
    },
    {
      "name": "rust",
      "paths": [
        "checks/rust/**"
      ]
    },
    {
      "name": "go",
      "paths": [
        "checks/go/**"
      ]
    },
    {
      "name": "shell",
      "paths": [
        "checks/shell/**",
        "tools/**"
      ]
    },
    {
      "name": "fixtures",
      "paths": [
        "template-fixtures/**",
        "tests/fixtures/**"
      ]
    }
  ]
}
